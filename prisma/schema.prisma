// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider   = "prisma-client"
  output     = "../generated/prisma"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

enum CaseStatus {
  ENTRY
  WAITING_INFO
  DESIGNING
  WAITING_APPROVAL
  DESIGN_READY
  MILLING_PRINTING
  DONE
}

enum MillingStatus {
  SUCCESS
  FAILED
}

enum UserRole {
  ADMIN
  MANAGER
  CAD_DESIGNER
  PRODUCTION
}

enum AttachmentKind {
  SCAN_INPUT
  DESIGN_OUTPUT
  MODEL_OUTPUT
  OTHER
}

enum NotificationType {
  CASE_ASSIGNED
  SCAN_UPLOADED
  DESIGN_UPLOADED
  CASE_STATUS_CHANGED
}

model users {
  id              String   @id @default(uuid()) @db.Uuid
  clientCompanyId String   @db.Uuid
  name            String
  email           String   @unique
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  client_companies  client_companies       @relation(fields: [clientCompanyId], references: [id], onDelete: Cascade)
  labMemberships    user_lab_memberships[]
  assignedCases     cases[]                @relation("CaseCadDesigner")
  createdCases      cases[]                @relation("CaseCreatedBy")
  case_attachments  case_attachments[]
  notifications     notifications[]        @relation("NotificationRecipient")
  pushSubscriptions push_subscriptions[]

  @@index([clientCompanyId])
}

model client_companies {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users      users[]
  dentalLabs dental_labs[]
}

model dental_labs {
  id              String   @id @default(cuid())
  clientCompanyId String   @db.Uuid
  name            String
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  client_companies client_companies       @relation(fields: [clientCompanyId], references: [id], onDelete: Cascade)
  memberships      user_lab_memberships[]
  labCustomers     lab_customers[]
  clinics          clinics[]
  dentists         dentists[]
  service_types    service_types[]
  components       components[]
  block_types      block_types[]
  milling_drills   milling_drills[]
  cases            cases[]
  millings         case_millings[]

  @@unique([clientCompanyId, name])
  @@index([clientCompanyId])
}

model lab_customers {
  id          String   @id @default(cuid())
  dentalLabId String
  name        String
  phone       String?
  email       String?
  notes       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  dental_labs dental_labs @relation(fields: [dentalLabId], references: [id], onDelete: Cascade)
  clinics     clinics[]

  @@unique([dentalLabId, name])
  @@index([dentalLabId])
}

model user_lab_memberships {
  id          String   @id @default(cuid())
  userId      String   @db.Uuid
  dentalLabId String
  role        UserRole
  createdAt   DateTime @default(now())

  users       users       @relation(fields: [userId], references: [id], onDelete: Cascade)
  dental_labs dental_labs @relation(fields: [dentalLabId], references: [id], onDelete: Cascade)

  @@unique([userId])
  @@unique([userId, dentalLabId])
  @@index([dentalLabId])
}

model service_types {
  id          String   @id @default(cuid())
  dentalLabId String
  name        String
  isActive    Boolean  @default(true)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  dental_labs dental_labs @relation(fields: [dentalLabId], references: [id], onDelete: Cascade)
  cases       cases[]

  @@unique([dentalLabId, name])
  @@index([dentalLabId])
}

model milling_drills {
  dentalLabId         String
  id                  String    @id @default(cuid())
  name                String
  type                String?
  brand               String?
  serialNumber        String?   @unique
  maxTeethRecommended Int?
  installedAt         DateTime?
  changedAt           DateTime?
  isActive            Boolean   @default(true)
  notes               String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  dental_labs    dental_labs     @relation(fields: [dentalLabId], references: [id], onDelete: Cascade)
  millings       case_millings[] @relation("LegacyMillingDrill")
  fineMillings   case_millings[] @relation("FineMillingDrill")
  coarseMillings case_millings[] @relation("CoarseMillingDrill")

  @@unique([dentalLabId, name])
  @@index([dentalLabId])
}

model case_millings {
  id                   String        @id @default(cuid())
  dentalLabId          String
  caseId               String
  blockTypeId          String
  millingDrillId       String?
  fineMillingDrillId   String?
  coarseMillingDrillId String?
  redoneFromMillingId  String?
  status               MillingStatus @default(SUCCESS)

  teethMilledQty Int      @default(0)
  failureReason  String?
  notes          String?
  milledAt       DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  dental_labs        dental_labs     @relation(fields: [dentalLabId], references: [id], onDelete: Cascade)
  cases              cases           @relation(fields: [caseId], references: [id], onDelete: Cascade)
  block_types        block_types     @relation(fields: [blockTypeId], references: [id], onDelete: Restrict)
  milling_drills     milling_drills? @relation("LegacyMillingDrill", fields: [millingDrillId], references: [id], onDelete: SetNull)
  fineMillingDrill   milling_drills? @relation("FineMillingDrill", fields: [fineMillingDrillId], references: [id], onDelete: SetNull)
  coarseMillingDrill milling_drills? @relation("CoarseMillingDrill", fields: [coarseMillingDrillId], references: [id], onDelete: SetNull)
  redoneFromMilling  case_millings?  @relation("MillingRedo", fields: [redoneFromMillingId], references: [id], onDelete: SetNull)
  redos              case_millings[] @relation("MillingRedo")

  @@index([dentalLabId])
  @@index([caseId])
  @@index([blockTypeId])
  @@index([millingDrillId])
  @@index([fineMillingDrillId])
  @@index([coarseMillingDrillId])
  @@index([redoneFromMillingId])
  @@index([status])
}

model case_attachments {
  id             String         @id @default(cuid())
  caseId         String
  fileName       String
  filePath       String
  fileType       String?
  fileSize       Int?
  kind           AttachmentKind @default(OTHER)
  retentionUntil DateTime?
  archivedAt     DateTime?
  uploadedById   String?        @db.Uuid
  createdAt      DateTime       @default(now())
  cases          cases          @relation(fields: [caseId], references: [id], onDelete: Cascade)
  uploadedBy     users?         @relation(fields: [uploadedById], references: [id])

  @@index([caseId, kind, createdAt])
}

model clinics {
  id            String   @id @default(cuid())
  dentalLabId   String
  labCustomerId String?
  name          String
  phone         String?
  email         String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  dental_labs   dental_labs    @relation(fields: [dentalLabId], references: [id], onDelete: Cascade)
  lab_customers lab_customers? @relation(fields: [labCustomerId], references: [id], onDelete: SetNull)
  dentists      dentists[]
  cases         cases[]

  @@index([dentalLabId])
  @@index([labCustomerId])
}

model dentists {
  id          String   @id @default(cuid())
  dentalLabId String
  clinicId    String
  name        String
  phone       String?
  email       String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  dental_labs dental_labs @relation(fields: [dentalLabId], references: [id], onDelete: Cascade)
  clinics     clinics     @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  cases       cases[]

  @@index([dentalLabId])
  @@index([clinicId])
}

model components {
  id           String   @id @default(cuid())
  dentalLabId  String
  name         String
  category     String?
  brand        String?
  defaultCost  Decimal? @db.Decimal(10, 2)
  defaultPrice Decimal? @db.Decimal(10, 2)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  dental_labs dental_labs             @relation(fields: [dentalLabId], references: [id], onDelete: Cascade)
  caseUsages  case_component_usages[]

  @@unique([dentalLabId, name])
  @@index([dentalLabId])
}

model case_component_usages {
  id           String   @id @default(cuid())
  caseId       String
  componentId  String
  quantity     Int      @default(1)
  chargeClient Boolean  @default(true)
  unitCost     Decimal? @db.Decimal(10, 2)
  unitPrice    Decimal? @db.Decimal(10, 2)
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  cases      cases      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  components components @relation(fields: [componentId], references: [id], onDelete: Restrict)

  @@index([caseId])
  @@index([componentId])
}

model block_types {
  id          String   @id @default(cuid())
  dentalLabId String
  name        String
  material    String?
  brand       String?
  size        String?
  shade       String?
  defaultCost Decimal? @db.Decimal(10, 2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  dental_labs dental_labs     @relation(fields: [dentalLabId], references: [id], onDelete: Cascade)
  millings    case_millings[]

  @@unique([dentalLabId, name])
  @@index([dentalLabId])
}

model cases {
  id              String     @id @default(cuid())
  dentalLabId     String
  code            String
  clientCaseCode  String?
  patientName     String
  clinicId        String?
  serviceTypeId   String?
  dentistId       String?
  cadDesignerId   String?    @db.Uuid
  createdByUserId String?    @db.Uuid
  currentStatus   CaseStatus @default(ENTRY)

  teeth        String?
  elementsQty  Int?
  shade        String?
  dueDate      DateTime?
  isUrgent     Boolean   @default(false)
  observations String?
  pendingNote  String?

  caseComponentUsages case_component_usages[]
  statusHistory       case_status_histories[]
  millings            case_millings[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dental_labs      dental_labs        @relation(fields: [dentalLabId], references: [id], onDelete: Cascade)
  clinics          clinics?           @relation(fields: [clinicId], references: [id])
  dentists         dentists?          @relation(fields: [dentistId], references: [id])
  service_types    service_types?     @relation(fields: [serviceTypeId], references: [id], onDelete: SetNull)
  cadDesigner      users?             @relation("CaseCadDesigner", fields: [cadDesignerId], references: [id], onDelete: SetNull)
  createdByUser    users?             @relation("CaseCreatedBy", fields: [createdByUserId], references: [id])
  case_attachments case_attachments[]
  notifications    notifications[]

  @@unique([dentalLabId, code])
  @@index([dentalLabId])
  @@index([clinicId])
  @@index([dentistId])
  @@index([currentStatus])
  @@index([serviceTypeId])
  @@index([cadDesignerId])
  @@index([createdByUserId])
}

model case_status_histories {
  id         String      @id @default(cuid())
  caseId     String
  fromStatus CaseStatus?
  toStatus   CaseStatus
  note       String?
  changedAt  DateTime    @default(now())

  cases cases @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([toStatus])
}

model notifications {
  id              String           @id @default(cuid())
  recipientUserId String           @db.Uuid
  caseId          String?
  type            NotificationType
  title           String
  message         String
  payload         Json?
  isRead          Boolean          @default(false)
  readAt          DateTime?
  createdAt       DateTime         @default(now())

  recipientUser users  @relation("NotificationRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)
  cases         cases? @relation(fields: [caseId], references: [id], onDelete: SetNull)

  @@index([recipientUserId, isRead, createdAt])
  @@index([caseId])
}

model push_subscriptions {
  id        String   @id @default(cuid())
  userId    String   @db.Uuid
  endpoint  String   @unique
  p256dh    String
  auth      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users users @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
}
