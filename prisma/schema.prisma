// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider   = "prisma-client"
  output     = "../generated/prisma"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

enum CaseStatus {
  IN_PRODUCTION
  STANDBY
  DONE
  CANCELLED
}

enum CasePriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum MillingStatus {
  SUCCESS
  FAILED
}

enum MillingDrillStatus {
  ACTIVE
  STORED
  RETIRED
  LOST
}

enum MillingMachineStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum CaseProcessStatus {
  LOCKED      @map("locked")
  READY       @map("ready")
  IN_PROGRESS @map("in_progress")
  COMPLETED   @map("completed")
  SKIPPED     @map("skipped")
  CANCELLED   @map("cancelled")
}

enum CaseProcessHistoryEventType {
  STARTED
  COMPLETED
}

enum CaseProcessSchedulingStatus {
  UNSCHEDULED
  SCHEDULED
  AT_RISK
}

enum ScheduleProposalStatus {
  DRAFT
  APPROVED
  REJECTED
}

enum UserRole {
  OWNER
  ADMIN
  MANAGER
  PRODUCTION
}

enum AttachmentKind {
  SCAN_INPUT
  DESIGN_OUTPUT
  MODEL_OUTPUT
  OTHER
}

enum NotificationType {
  CASE_ASSIGNED
  SCAN_UPLOADED
  DESIGN_UPLOADED
  CASE_STATUS_CHANGED
}

model users {
  id         String    @id @default(uuid(7)) @db.Uuid
  name       String
  email      String    @unique
  is_active  Boolean   @default(true)
  deleted_at DateTime?
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  memberships         lab_members[]
  createdCases        cases[]              @relation("CaseCreatedBy")
  caseComments        case_comments[]      @relation("CaseCommentAuthor")
  deletedCaseComments case_comments[]      @relation("CaseCommentDeletedBy")
  caseThreadReads     case_thread_reads[]  @relation("CaseThreadReadUser")
  caseProcessHistoryEvents case_process_history_events[] @relation("CaseProcessHistoryActor")
  case_attachments    case_attachments[]
  notifications       notifications[]      @relation("NotificationRecipient")
  pushSubscriptions   push_subscriptions[]
  employeeInvitesSent employee_invites[]   @relation("EmployeeInviteInvitedBy")
  createdScheduleProposals schedule_proposals[] @relation("ScheduleProposalCreatedBy")
  approvedScheduleProposals schedule_proposals[] @relation("ScheduleProposalApprovedBy")
  rejectedScheduleProposals schedule_proposals[] @relation("ScheduleProposalRejectedBy")
}

model labs {
  id         String   @id @default(uuid(7)) @db.Uuid
  name       String
  currency   String   @default("BRL")
  timezone   String   @default("America/Sao_Paulo")
  is_active  Boolean  @default(true)
  schedule_revision Int @default(1)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  memberships                lab_members[]
  customers                  customers[]
  dentists                   dentists[]
  service_types              service_types[]
  price_tables               price_tables[]
  components                 components[]
  block_types                block_types[]
  milling_machines           milling_machines[]
  milling_drills             milling_drills[]
  processes                  processes[]
  employeeProcessAssignments employee_process_assignments[]
  employeeInvites            employee_invites[]
  cases                      cases[]
  millings                   case_millings[]
  scheduleProposals          schedule_proposals[]

  @@unique([name])
}

model lab_members {
  id         String   @id @default(uuid(7)) @db.Uuid
  user_id    String   @db.Uuid
  lab_id     String   @db.Uuid
  role       UserRole
  created_at DateTime @default(now())

  users             users                          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  labs              labs                           @relation(fields: [lab_id], references: [id], onDelete: Cascade)
  assignedProcesses case_processes[]               @relation("CaseProcessAssignee")
  processOwnerships employee_process_assignments[]
  caseComments      case_comments[]                @relation("CaseCommentLabMember")
  caseThreadReads   case_thread_reads[]            @relation("CaseThreadReadLabMember")
  scheduleShifts    employee_schedule_shifts[]
  scheduleExceptions employee_schedule_exceptions[]
  scheduleAllocations case_process_schedule_allocations[]

  @@unique([user_id])
  @@unique([user_id, lab_id])
  @@index([lab_id])
}

model employee_invites {
  id                 String    @id @default(uuid(7)) @db.Uuid
  lab_id             String    @db.Uuid
  invited_by_user_id String    @db.Uuid
  auth_user_id       String?   @unique @db.Uuid
  name               String
  email              String
  role               UserRole
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt
  last_sent_at       DateTime?
  accepted_at        DateTime?
  cancelled_at       DateTime?

  labs      labs  @relation(fields: [lab_id], references: [id], onDelete: Cascade)
  invitedBy users @relation("EmployeeInviteInvitedBy", fields: [invited_by_user_id], references: [id], onDelete: Restrict)

  @@unique([lab_id, email])
  @@index([lab_id, created_at])
}

model service_types {
  id            String    @id @default(uuid(7)) @db.Uuid
  lab_id        String    @db.Uuid
  name          String
  base_price    Decimal   @default(0) @db.Decimal(10, 2)
  delivery_buffer_days Int @default(0)
  is_active     Boolean   @default(true)
  deleted_at    DateTime?
  notes         String?
  workflow_json Json      @default("{\"steps\":[]}")
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  labs                       labs                         @relation(fields: [lab_id], references: [id], onDelete: Cascade)
  cases                      cases[]
  case_services              case_services[]
  price_table_service_prices price_table_service_prices[]

  @@unique([lab_id, name])
  @@index([lab_id])
}

model price_tables {
  id         String    @id @default(uuid(7)) @db.Uuid
  lab_id     String    @db.Uuid
  name       String
  is_active  Boolean   @default(true)
  deleted_at DateTime?
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  labs                       labs                         @relation(fields: [lab_id], references: [id], onDelete: Cascade)
  customers                  customers[]
  price_table_service_prices price_table_service_prices[]

  @@index([lab_id])
  @@index([lab_id, name])
}

model price_table_service_prices {
  id              String   @id @default(uuid(7)) @db.Uuid
  price_table_id  String   @db.Uuid
  service_type_id String   @db.Uuid
  price           Decimal  @db.Decimal(10, 2)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  price_tables  price_tables  @relation(fields: [price_table_id], references: [id], onDelete: Cascade)
  service_types service_types @relation(fields: [service_type_id], references: [id], onDelete: Restrict)

  @@unique([price_table_id, service_type_id])
  @@index([price_table_id])
  @@index([service_type_id])
}

model processes {
  id                            String    @id @default(uuid(7)) @db.Uuid
  lab_id                        String    @db.Uuid
  name                          String
  description                   String?
  default_fixed_minutes         Int       @default(1)
  default_expected_duration_days Int      @default(1)
  default_requires_milling_machine Boolean @default(false)
  default_labor_cost            Decimal   @default(0) @db.Decimal(10, 2)
  is_active                     Boolean   @default(true)
  deleted_at                    DateTime?
  created_at                    DateTime  @default(now())
  updated_at                    DateTime  @updatedAt

  labs                labs                           @relation(fields: [lab_id], references: [id], onDelete: Cascade)
  case_processes      case_processes[]
  employeeAssignments employee_process_assignments[]

  @@unique([lab_id, name])
  @@index([lab_id])
}

model employee_process_assignments {
  id            String   @id @default(uuid(7)) @db.Uuid
  lab_id        String   @db.Uuid
  lab_member_id String   @db.Uuid
  process_id    String   @db.Uuid
  productivity_points_per_hour Decimal @default(1) @db.Decimal(10, 2)
  labor_cost_override Decimal? @db.Decimal(10, 2)
  created_at    DateTime @default(now())

  labs        labs        @relation(fields: [lab_id], references: [id], onDelete: Cascade)
  lab_members lab_members @relation(fields: [lab_member_id], references: [id], onDelete: Cascade)
  processes   processes   @relation(fields: [process_id], references: [id], onDelete: Cascade)

  @@unique([lab_id, lab_member_id, process_id])
  @@index([lab_id])
  @@index([lab_member_id])
  @@index([process_id])
}

model milling_drills {
  id                   String             @id @default(uuid(7)) @db.Uuid
  lab_id               String             @db.Uuid
  milling_machine_id   String?            @db.Uuid
  name                 String
  status               MillingDrillStatus @default(ACTIVE)
  current_blocks_count Int                @default(0)
  estimated_max_blocks Int?
  installed_at         DateTime?
  removed_at           DateTime?
  notes                String?
  created_at           DateTime           @default(now())
  updated_at           DateTime           @updatedAt

  labs             labs                       @relation(fields: [lab_id], references: [id], onDelete: Cascade)
  milling_machines milling_machines?          @relation(fields: [milling_machine_id], references: [id], onDelete: SetNull)
  millings         case_millings[]            @relation("LegacyMillingDrill")
  fineMillings     case_millings[]            @relation("FineMillingDrill")
  coarseMillings   case_millings[]            @relation("CoarseMillingDrill")
  selected_slots   case_milling_drill_slots[]

  @@unique([lab_id, name])
  @@index([lab_id])
  @@index([milling_machine_id])
  @@index([status])
}

model milling_machines {
  id                      String               @id @default(uuid(7)) @db.Uuid
  lab_id                  String               @db.Uuid
  name                    String
  serial_number           String?
  model                   String?
  status                  MillingMachineStatus @default(ACTIVE)
  productivity_points_per_hour Decimal         @default(1) @db.Decimal(10, 2)
  status_reason           String?
  installed_at            DateTime?
  removed_at              DateTime?
  last_maintenance_at     DateTime?
  next_maintenance_due_at DateTime?
  notes                   String?
  created_at              DateTime             @default(now())
  updated_at              DateTime             @updatedAt

  labs           labs                    @relation(fields: [lab_id], references: [id], onDelete: Cascade)
  case_millings  case_millings[]
  milling_drills milling_drills[]
  machine_slots  milling_machine_slots[]
  planned_case_processes case_processes[] @relation("CaseProcessPlannedMillingMachine")
  scheduleAllocations case_process_schedule_allocations[]
  scheduleShifts milling_machine_schedule_shifts[]
  scheduleExceptions milling_machine_schedule_exceptions[]

  @@unique([lab_id, name])
  @@unique([lab_id, serial_number])
  @@index([lab_id])
  @@index([status])
}

model milling_machine_slots {
  id                 String   @id @default(uuid(7)) @db.Uuid
  milling_machine_id String   @db.Uuid
  label              String
  sort_order         Int
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  milling_machines       milling_machines           @relation(fields: [milling_machine_id], references: [id], onDelete: Cascade)
  selected_milling_slots case_milling_drill_slots[]

  @@unique([milling_machine_id, label])
  @@unique([milling_machine_id, sort_order])
  @@index([milling_machine_id])
}

model case_millings {
  id                      String        @id @default(uuid(7)) @db.Uuid
  lab_id                  String        @db.Uuid
  case_id                 String        @db.Uuid
  block_type_id           String        @db.Uuid
  milling_machine_id      String?       @db.Uuid
  milling_drill_id        String?       @db.Uuid
  fine_milling_drill_id   String?       @db.Uuid
  coarse_milling_drill_id String?       @db.Uuid
  redone_from_milling_id  String?       @db.Uuid
  status                  MillingStatus @default(SUCCESS)

  teeth_milled_qty Int      @default(0)
  blocks_used_qty  Int      @default(1)
  failure_reason   String?
  notes            String?
  milled_at        DateTime @default(now())
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  labs                 labs                       @relation(fields: [lab_id], references: [id], onDelete: Cascade)
  cases                cases                      @relation(fields: [case_id], references: [id], onDelete: Cascade)
  block_types          block_types                @relation(fields: [block_type_id], references: [id], onDelete: Restrict)
  milling_machines     milling_machines?          @relation(fields: [milling_machine_id], references: [id], onDelete: SetNull)
  milling_drills       milling_drills?            @relation("LegacyMillingDrill", fields: [milling_drill_id], references: [id], onDelete: SetNull)
  fineMillingDrill     milling_drills?            @relation("FineMillingDrill", fields: [fine_milling_drill_id], references: [id], onDelete: SetNull)
  coarseMillingDrill   milling_drills?            @relation("CoarseMillingDrill", fields: [coarse_milling_drill_id], references: [id], onDelete: SetNull)
  selected_drill_slots case_milling_drill_slots[]
  redoneFromMilling    case_millings?             @relation("MillingRedo", fields: [redone_from_milling_id], references: [id], onDelete: SetNull)
  redos                case_millings[]            @relation("MillingRedo")

  @@index([lab_id])
  @@index([case_id])
  @@index([block_type_id])
  @@index([milling_machine_id])
  @@index([milling_drill_id])
  @@index([fine_milling_drill_id])
  @@index([coarse_milling_drill_id])
  @@index([redone_from_milling_id])
  @@index([status])
}

model case_milling_drill_slots {
  id                      String   @id @default(uuid(7)) @db.Uuid
  milling_id              String   @db.Uuid
  milling_machine_slot_id String?  @db.Uuid
  milling_drill_id        String   @db.Uuid
  slot_label_snapshot     String
  slot_order_snapshot     Int
  created_at              DateTime @default(now())
  updated_at              DateTime @updatedAt

  case_millings         case_millings          @relation(fields: [milling_id], references: [id], onDelete: Cascade)
  milling_machine_slots milling_machine_slots? @relation(fields: [milling_machine_slot_id], references: [id], onDelete: SetNull)
  milling_drills        milling_drills         @relation(fields: [milling_drill_id], references: [id], onDelete: Restrict)

  @@unique([milling_id, slot_order_snapshot])
  @@index([milling_id])
  @@index([milling_machine_slot_id])
  @@index([milling_drill_id])
}

model case_attachments {
  id              String         @id @default(uuid(7)) @db.Uuid
  case_id         String         @db.Uuid
  file_name       String
  file_path       String
  file_type       String?
  file_size       Int?
  kind            AttachmentKind @default(OTHER)
  retention_until DateTime?
  archived_at     DateTime?
  uploaded_by_id  String?        @db.Uuid
  created_at      DateTime       @default(now())
  cases           cases          @relation(fields: [case_id], references: [id], onDelete: Cascade)
  uploadedBy      users?         @relation(fields: [uploaded_by_id], references: [id])

  @@index([case_id, kind, created_at])
}

model customers {
  id             String    @id @default(uuid(7)) @db.Uuid
  lab_id         String    @db.Uuid
  price_table_id String?   @db.Uuid
  name           String
  phone          String?
  email          String?
  notes          String?
  is_active      Boolean   @default(true)
  deleted_at     DateTime?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  labs         labs          @relation(fields: [lab_id], references: [id], onDelete: Cascade)
  price_tables price_tables? @relation(fields: [price_table_id], references: [id], onDelete: SetNull)
  dentists     dentists[]
  cases        cases[]

  @@index([lab_id])
  @@index([price_table_id])
}

model dentists {
  id          String    @id @default(uuid(7)) @db.Uuid
  lab_id      String    @db.Uuid
  customer_id String    @db.Uuid
  name        String
  phone       String?
  email       String?
  notes       String?
  is_active   Boolean   @default(true)
  deleted_at  DateTime?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  labs      labs      @relation(fields: [lab_id], references: [id], onDelete: Cascade)
  customers customers @relation(fields: [customer_id], references: [id], onDelete: Restrict)
  cases     cases[]

  @@index([lab_id])
  @@index([customer_id])
}

model components {
  id            String    @id @default(uuid(7)) @db.Uuid
  lab_id        String    @db.Uuid
  name          String
  category      String?
  brand         String?
  default_cost  Decimal?  @db.Decimal(10, 2)
  default_price Decimal?  @db.Decimal(10, 2)
  is_active     Boolean   @default(true)
  deleted_at    DateTime?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  labs       labs                    @relation(fields: [lab_id], references: [id], onDelete: Cascade)
  caseUsages case_component_usages[]

  @@unique([lab_id, name])
  @@index([lab_id])
}

model case_component_usages {
  id            String   @id @default(uuid(7)) @db.Uuid
  case_id       String   @db.Uuid
  component_id  String   @db.Uuid
  quantity      Int      @default(1)
  charge_client Boolean  @default(true)
  unit_cost     Decimal? @db.Decimal(10, 2)
  unit_price    Decimal? @db.Decimal(10, 2)
  notes         String?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  cases      cases      @relation(fields: [case_id], references: [id], onDelete: Cascade)
  components components @relation(fields: [component_id], references: [id], onDelete: Restrict)

  @@index([case_id])
  @@index([component_id])
}

model block_types {
  id           String    @id @default(uuid(7)) @db.Uuid
  lab_id       String    @db.Uuid
  name         String
  material     String?
  brand        String?
  size         String?
  shade        String?
  default_cost Decimal?  @db.Decimal(10, 2)
  is_active    Boolean   @default(true)
  deleted_at   DateTime?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  labs     labs            @relation(fields: [lab_id], references: [id], onDelete: Cascade)
  millings case_millings[]

  @@unique([lab_id, name])
  @@index([lab_id])
}

model cases {
  id                          String     @id @default(uuid(7)) @db.Uuid
  lab_id                      String     @db.Uuid
  code                        String
  patient_name                String
  customer_id                 String?    @db.Uuid
  service_type_id             String?    @db.Uuid
  dentist_id                  String?    @db.Uuid
  created_by_user_id          String?    @db.Uuid
  current_status              CaseStatus @default(IN_PRODUCTION)
  service_base_price_snapshot Decimal?   @db.Decimal(10, 2)
  case_price                  Decimal?   @db.Decimal(10, 2)
  is_price_overridden         Boolean    @default(false)
  priority                    CasePriority @default(NORMAL)

  teeth        String?
  elements_qty Int?
  shade        String?
  due_date     DateTime?
  is_urgent    Boolean   @default(false)
  observations String?

  caseComponentUsages case_component_usages[]
  statusHistory       case_status_histories[]
  millings            case_millings[]
  case_processes      case_processes[]
  processHistory      case_process_history_events[]
  case_services       case_services[]
  case_comments       case_comments[]
  case_thread_reads   case_thread_reads[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  labs             labs               @relation(fields: [lab_id], references: [id], onDelete: Cascade)
  customers        customers?         @relation(fields: [customer_id], references: [id])
  dentists         dentists?          @relation(fields: [dentist_id], references: [id])
  service_types    service_types?     @relation(fields: [service_type_id], references: [id], onDelete: Restrict)
  createdByUser    users?             @relation("CaseCreatedBy", fields: [created_by_user_id], references: [id])
  case_attachments case_attachments[]
  notifications    notifications[]

  @@unique([lab_id, code])
  @@index([lab_id])
  @@index([lab_id, created_at])
  @@index([lab_id, current_status, created_at])
  @@index([lab_id, customer_id, created_at])
  @@index([customer_id])
  @@index([dentist_id])
  @@index([current_status])
  @@index([service_type_id])
  @@index([created_by_user_id])
}

model case_comments {
  id                   String    @id @default(uuid(7)) @db.Uuid
  case_id              String    @db.Uuid
  author_user_id       String    @db.Uuid
  author_lab_member_id String    @db.Uuid
  body                 String
  created_at           DateTime  @default(now())
  deleted_at           DateTime?
  deleted_by_user_id   String?   @db.Uuid

  cases           cases               @relation(fields: [case_id], references: [id], onDelete: Cascade)
  authorUser      users               @relation("CaseCommentAuthor", fields: [author_user_id], references: [id], onDelete: Restrict)
  authorLabMember lab_members         @relation("CaseCommentLabMember", fields: [author_lab_member_id], references: [id], onDelete: Restrict)
  deletedByUser   users?              @relation("CaseCommentDeletedBy", fields: [deleted_by_user_id], references: [id], onDelete: SetNull)
  readStates      case_thread_reads[] @relation("CaseThreadReadLastComment")

  @@index([case_id, created_at])
  @@index([author_user_id])
  @@index([author_lab_member_id])
  @@index([deleted_by_user_id])
}

model case_thread_reads {
  id                   String    @id @default(uuid(7)) @db.Uuid
  case_id              String    @db.Uuid
  user_id              String    @db.Uuid
  lab_member_id        String    @db.Uuid
  last_read_comment_id String?   @db.Uuid
  last_read_at         DateTime?
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt

  cases           cases          @relation(fields: [case_id], references: [id], onDelete: Cascade)
  users           users          @relation("CaseThreadReadUser", fields: [user_id], references: [id], onDelete: Cascade)
  lab_members     lab_members    @relation("CaseThreadReadLabMember", fields: [lab_member_id], references: [id], onDelete: Cascade)
  lastReadComment case_comments? @relation("CaseThreadReadLastComment", fields: [last_read_comment_id], references: [id], onDelete: SetNull)

  @@unique([case_id, lab_member_id])
  @@index([user_id])
  @@index([lab_member_id])
  @@index([last_read_comment_id])
}

model case_processes {
  id                     String            @id @default(uuid(7)) @db.Uuid
  case_id                String            @db.Uuid
  case_service_id        String            @db.Uuid
  process_id             String            @db.Uuid
  workflow_step_id       String
  status                 CaseProcessStatus @default(LOCKED)
  assigned_lab_member_id String?           @db.Uuid
  snapshot_fixed_minutes Int               @default(1)
  snapshot_expected_duration_days Int      @default(1)
  snapshot_requires_milling_machine Boolean @default(false)
  planned_start_date     DateTime?
  planned_end_date       DateTime?
  scheduling_locked      Boolean           @default(false)
  scheduling_status      CaseProcessSchedulingStatus @default(UNSCHEDULED)
  planned_milling_machine_id String?       @db.Uuid
  started_at             DateTime?
  completed_at           DateTime?
  created_at             DateTime          @default(now())
  updated_at             DateTime          @updatedAt

  cases              cases                       @relation(fields: [case_id], references: [id], onDelete: Cascade)
  case_services      case_services               @relation(fields: [case_service_id], references: [id], onDelete: Cascade)
  processes          processes                   @relation(fields: [process_id], references: [id], onDelete: Restrict)
  assignedLabMember  lab_members?                @relation("CaseProcessAssignee", fields: [assigned_lab_member_id], references: [id], onDelete: SetNull)
  plannedMillingMachine milling_machines?        @relation("CaseProcessPlannedMillingMachine", fields: [planned_milling_machine_id], references: [id], onDelete: SetNull)
  historyEvents      case_process_history_events[]
  dependencies       case_process_dependencies[] @relation("CaseProcessDependencyTarget")
  dependentProcesses case_process_dependencies[] @relation("CaseProcessDependencySource")
  scheduleAllocations case_process_schedule_allocations[]

  @@unique([case_service_id, workflow_step_id])
  @@index([case_id])
  @@index([case_service_id])
  @@index([process_id])
  @@index([assigned_lab_member_id])
  @@index([planned_milling_machine_id])
  @@index([status])
  @@index([planned_start_date])
  @@index([planned_end_date])
}

model case_process_history_events {
  id              String                      @id @default(uuid(7)) @db.Uuid
  case_id         String                      @db.Uuid
  case_process_id String                      @db.Uuid
  actor_user_id   String?                     @db.Uuid
  event_type      CaseProcessHistoryEventType
  created_at      DateTime                    @default(now())

  cases       cases          @relation(fields: [case_id], references: [id], onDelete: Cascade)
  caseProcess case_processes @relation(fields: [case_process_id], references: [id], onDelete: Cascade)
  actorUser   users?         @relation("CaseProcessHistoryActor", fields: [actor_user_id], references: [id], onDelete: SetNull)

  @@index([case_id, created_at])
  @@index([case_process_id, created_at])
  @@index([actor_user_id])
}

model case_services {
  id                          String   @id @default(uuid(7)) @db.Uuid
  case_id                     String   @db.Uuid
  service_type_id             String   @db.Uuid
  service_name_snapshot       String
  service_base_price_snapshot Decimal  @db.Decimal(10, 2)
  delivery_buffer_days_snapshot Int    @default(0)
  unit_price                  Decimal  @db.Decimal(10, 2)
  is_unit_price_overridden    Boolean  @default(false)
  quantity                    Int
  created_at                  DateTime @default(now())
  updated_at                  DateTime @updatedAt

  cases          cases            @relation(fields: [case_id], references: [id], onDelete: Cascade)
  service_types  service_types    @relation(fields: [service_type_id], references: [id], onDelete: Restrict)
  case_processes case_processes[]

  @@index([case_id])
  @@index([service_type_id])
}

model case_process_dependencies {
  id                         String @id @default(uuid(7)) @db.Uuid
  case_process_id            String @db.Uuid
  depends_on_case_process_id String @db.Uuid

  caseProcess          case_processes @relation("CaseProcessDependencyTarget", fields: [case_process_id], references: [id], onDelete: Cascade)
  dependsOnCaseProcess case_processes @relation("CaseProcessDependencySource", fields: [depends_on_case_process_id], references: [id], onDelete: Cascade)

  @@unique([case_process_id, depends_on_case_process_id])
  @@index([case_process_id])
  @@index([depends_on_case_process_id])
}

model case_process_schedule_allocations {
  id                 String   @id @default(uuid(7)) @db.Uuid
  case_process_id    String   @db.Uuid
  lab_member_id      String   @db.Uuid
  allocation_date    DateTime
  planned_minutes    Int
  milling_machine_id String?  @db.Uuid
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  caseProcess     case_processes    @relation(fields: [case_process_id], references: [id], onDelete: Cascade)
  lab_members     lab_members       @relation(fields: [lab_member_id], references: [id], onDelete: Cascade)
  millingMachine  milling_machines? @relation(fields: [milling_machine_id], references: [id], onDelete: SetNull)

  @@unique([case_process_id, allocation_date])
  @@index([lab_member_id, allocation_date])
  @@index([milling_machine_id, allocation_date])
}

model employee_schedule_shifts {
  id            String   @id @default(uuid(7)) @db.Uuid
  lab_member_id String   @db.Uuid
  day_of_week   Int
  available_minutes Int
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  lab_members lab_members @relation(fields: [lab_member_id], references: [id], onDelete: Cascade)

  @@unique([lab_member_id, day_of_week])
  @@index([lab_member_id, day_of_week])
}

model employee_schedule_exceptions {
  id            String   @id @default(uuid(7)) @db.Uuid
  lab_member_id String   @db.Uuid
  exception_date DateTime
  available_minutes Int
  reason        String?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  lab_members lab_members @relation(fields: [lab_member_id], references: [id], onDelete: Cascade)

  @@index([lab_member_id, exception_date])
}

model milling_machine_schedule_shifts {
  id                 String   @id @default(uuid(7)) @db.Uuid
  milling_machine_id String   @db.Uuid
  day_of_week        Int
  start_minute       Int
  end_minute         Int
  is_active          Boolean  @default(true)
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  millingMachine milling_machines @relation(fields: [milling_machine_id], references: [id], onDelete: Cascade)

  @@index([milling_machine_id, day_of_week])
}

model milling_machine_schedule_exceptions {
  id                 String   @id @default(uuid(7)) @db.Uuid
  milling_machine_id String   @db.Uuid
  exception_date     DateTime
  start_minute       Int?
  end_minute         Int?
  is_available       Boolean
  reason             String?
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  millingMachine milling_machines @relation(fields: [milling_machine_id], references: [id], onDelete: Cascade)

  @@index([milling_machine_id, exception_date])
}

model schedule_proposals {
  id                  String                 @id @default(uuid(7)) @db.Uuid
  lab_id              String                 @db.Uuid
  status              ScheduleProposalStatus @default(DRAFT)
  source_revision     Int
  summary_json        Json
  changes_json        Json
  created_by_user_id  String?                @db.Uuid
  approved_by_user_id String?                @db.Uuid
  rejected_by_user_id String?                @db.Uuid
  decided_at          DateTime?
  created_at          DateTime               @default(now())
  updated_at          DateTime               @updatedAt

  labs            labs   @relation(fields: [lab_id], references: [id], onDelete: Cascade)
  createdByUser   users? @relation("ScheduleProposalCreatedBy", fields: [created_by_user_id], references: [id], onDelete: SetNull)
  approvedByUser  users? @relation("ScheduleProposalApprovedBy", fields: [approved_by_user_id], references: [id], onDelete: SetNull)
  rejectedByUser  users? @relation("ScheduleProposalRejectedBy", fields: [rejected_by_user_id], references: [id], onDelete: SetNull)

  @@index([lab_id, status, created_at])
}

model case_status_histories {
  id          String      @id @default(uuid(7)) @db.Uuid
  case_id     String      @db.Uuid
  from_status CaseStatus?
  to_status   CaseStatus
  note        String?
  changed_at  DateTime    @default(now())

  cases cases @relation(fields: [case_id], references: [id], onDelete: Cascade)

  @@index([case_id])
  @@index([to_status])
}

model notifications {
  id                String           @id @default(uuid(7)) @db.Uuid
  recipient_user_id String           @db.Uuid
  case_id           String?          @db.Uuid
  type              NotificationType
  title             String
  message           String
  payload           Json?
  is_read           Boolean          @default(false)
  read_at           DateTime?
  created_at        DateTime         @default(now())

  recipientUser users  @relation("NotificationRecipient", fields: [recipient_user_id], references: [id], onDelete: Cascade)
  cases         cases? @relation(fields: [case_id], references: [id], onDelete: SetNull)

  @@index([recipient_user_id, is_read, created_at])
  @@index([case_id])
}

model push_subscriptions {
  id         String   @id @default(uuid(7)) @db.Uuid
  user_id    String   @db.Uuid
  endpoint   String   @unique
  p256dh     String
  auth       String
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  users users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, is_active])
}
