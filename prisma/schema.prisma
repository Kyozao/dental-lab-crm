// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider   = "prisma-client"
  output     = "../generated/prisma"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

enum CaseStatus {
  ENTRY
  WAITING_INFO
  DESIGNING
  WAITING_APPROVAL
  DESIGN_READY
  MILLING_PRINTING
  DONE
}

enum MillingStatus {
  SUCCESS
  FAILED
}

enum CaseProcessStatus {
  LOCKED      @map("locked")
  READY       @map("ready")
  IN_PROGRESS @map("in_progress")
  COMPLETED   @map("completed")
  SKIPPED     @map("skipped")
  CANCELLED   @map("cancelled")
}

enum UserRole {
  OWNER
  ADMIN
  MANAGER
  CAD_DESIGNER
  PRODUCTION
}

enum AttachmentKind {
  SCAN_INPUT
  DESIGN_OUTPUT
  MODEL_OUTPUT
  OTHER
}

enum NotificationType {
  CASE_ASSIGNED
  SCAN_UPLOADED
  DESIGN_UPLOADED
  CASE_STATUS_CHANGED
}

model users {
  id         String    @id @default(uuid(7)) @db.Uuid
  name       String
  email      String    @unique
  is_active  Boolean   @default(true)
  deleted_at DateTime?
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  memberships       lab_members[]
  createdCases      cases[]              @relation("CaseCreatedBy")
  case_attachments  case_attachments[]
  notifications     notifications[]      @relation("NotificationRecipient")
  pushSubscriptions push_subscriptions[]
}

model labs {
  id         String   @id @default(uuid(7)) @db.Uuid
  name       String
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  memberships    lab_members[]
  customers      customers[]
  dentists       dentists[]
  service_types  service_types[]
  components     components[]
  block_types    block_types[]
  milling_drills milling_drills[]
  processes      processes[]
  employeeProcessAssignments employee_process_assignments[]
  cases          cases[]
  millings       case_millings[]

  @@unique([name])
}

model lab_members {
  id         String   @id @default(uuid(7)) @db.Uuid
  user_id    String   @db.Uuid
  lab_id     String   @db.Uuid
  role       UserRole
  created_at DateTime @default(now())

  users users @relation(fields: [user_id], references: [id], onDelete: Cascade)
  labs  labs  @relation(fields: [lab_id], references: [id], onDelete: Cascade)
  assignedProcesses case_processes[] @relation("CaseProcessAssignee")
  processOwnerships employee_process_assignments[]

  @@unique([user_id])
  @@unique([user_id, lab_id])
  @@index([lab_id])
}

model service_types {
  id            String    @id @default(uuid(7)) @db.Uuid
  lab_id        String    @db.Uuid
  name          String
  is_active     Boolean   @default(true)
  deleted_at    DateTime?
  notes         String?
  workflow_json Json      @default("{\"steps\":[]}")
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  labs  labs    @relation(fields: [lab_id], references: [id], onDelete: Cascade)
  cases cases[]

  @@unique([lab_id, name])
  @@index([lab_id])
}

model processes {
  id          String    @id @default(uuid(7)) @db.Uuid
  lab_id      String    @db.Uuid
  name        String
  description String?
  is_active   Boolean   @default(true)
  deleted_at  DateTime?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  labs           labs             @relation(fields: [lab_id], references: [id], onDelete: Cascade)
  case_processes case_processes[]
  employeeAssignments employee_process_assignments[]

  @@unique([lab_id, name])
  @@index([lab_id])
}

model employee_process_assignments {
  id            String   @id @default(uuid(7)) @db.Uuid
  lab_id        String   @db.Uuid
  lab_member_id String   @db.Uuid
  process_id    String   @db.Uuid
  created_at    DateTime @default(now())

  labs        labs        @relation(fields: [lab_id], references: [id], onDelete: Cascade)
  lab_members lab_members @relation(fields: [lab_member_id], references: [id], onDelete: Cascade)
  processes   processes   @relation(fields: [process_id], references: [id], onDelete: Cascade)

  @@unique([lab_id, lab_member_id, process_id])
  @@index([lab_id])
  @@index([lab_member_id])
  @@index([process_id])
}

model milling_drills {
  lab_id                String    @db.Uuid
  id                    String    @id @default(uuid(7)) @db.Uuid
  name                  String
  type                  String?
  brand                 String?
  serial_number         String?   @unique
  max_teeth_recommended Int?
  installed_at          DateTime?
  changed_at            DateTime?
  is_active             Boolean   @default(true)
  deleted_at            DateTime?
  notes                 String?
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt

  labs           labs            @relation(fields: [lab_id], references: [id], onDelete: Cascade)
  millings       case_millings[] @relation("LegacyMillingDrill")
  fineMillings   case_millings[] @relation("FineMillingDrill")
  coarseMillings case_millings[] @relation("CoarseMillingDrill")

  @@unique([lab_id, name])
  @@index([lab_id])
}

model case_millings {
  id                      String        @id @default(uuid(7)) @db.Uuid
  lab_id                  String        @db.Uuid
  case_id                 String        @db.Uuid
  block_type_id           String        @db.Uuid
  milling_drill_id        String?       @db.Uuid
  fine_milling_drill_id   String?       @db.Uuid
  coarse_milling_drill_id String?       @db.Uuid
  redone_from_milling_id  String?       @db.Uuid
  status                  MillingStatus @default(SUCCESS)

  teeth_milled_qty Int      @default(0)
  failure_reason   String?
  notes            String?
  milled_at        DateTime @default(now())
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  labs               labs            @relation(fields: [lab_id], references: [id], onDelete: Cascade)
  cases              cases           @relation(fields: [case_id], references: [id], onDelete: Cascade)
  block_types        block_types     @relation(fields: [block_type_id], references: [id], onDelete: Restrict)
  milling_drills     milling_drills? @relation("LegacyMillingDrill", fields: [milling_drill_id], references: [id], onDelete: SetNull)
  fineMillingDrill   milling_drills? @relation("FineMillingDrill", fields: [fine_milling_drill_id], references: [id], onDelete: SetNull)
  coarseMillingDrill milling_drills? @relation("CoarseMillingDrill", fields: [coarse_milling_drill_id], references: [id], onDelete: SetNull)
  redoneFromMilling  case_millings?  @relation("MillingRedo", fields: [redone_from_milling_id], references: [id], onDelete: SetNull)
  redos              case_millings[] @relation("MillingRedo")

  @@index([lab_id])
  @@index([case_id])
  @@index([block_type_id])
  @@index([milling_drill_id])
  @@index([fine_milling_drill_id])
  @@index([coarse_milling_drill_id])
  @@index([redone_from_milling_id])
  @@index([status])
}

model case_attachments {
  id              String         @id @default(uuid(7)) @db.Uuid
  case_id         String         @db.Uuid
  file_name       String
  file_path       String
  file_type       String?
  file_size       Int?
  kind            AttachmentKind @default(OTHER)
  retention_until DateTime?
  archived_at     DateTime?
  uploaded_by_id  String?        @db.Uuid
  created_at      DateTime       @default(now())
  cases           cases          @relation(fields: [case_id], references: [id], onDelete: Cascade)
  uploadedBy      users?         @relation(fields: [uploaded_by_id], references: [id])

  @@index([case_id, kind, created_at])
}

model customers {
  id         String    @id @default(uuid(7)) @db.Uuid
  lab_id     String    @db.Uuid
  name       String
  phone      String?
  email      String?
  notes      String?
  is_active  Boolean   @default(true)
  deleted_at DateTime?
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  labs     labs       @relation(fields: [lab_id], references: [id], onDelete: Cascade)
  dentists dentists[]
  cases    cases[]

  @@index([lab_id])
}

model dentists {
  id          String    @id @default(uuid(7)) @db.Uuid
  lab_id      String    @db.Uuid
  customer_id String    @db.Uuid
  name        String
  phone       String?
  email       String?
  notes       String?
  is_active   Boolean   @default(true)
  deleted_at  DateTime?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  labs      labs      @relation(fields: [lab_id], references: [id], onDelete: Cascade)
  customers customers @relation(fields: [customer_id], references: [id], onDelete: Restrict)
  cases     cases[]

  @@index([lab_id])
  @@index([customer_id])
}

model components {
  id            String    @id @default(uuid(7)) @db.Uuid
  lab_id        String    @db.Uuid
  name          String
  category      String?
  brand         String?
  default_cost  Decimal?  @db.Decimal(10, 2)
  default_price Decimal?  @db.Decimal(10, 2)
  is_active     Boolean   @default(true)
  deleted_at    DateTime?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  labs       labs                    @relation(fields: [lab_id], references: [id], onDelete: Cascade)
  caseUsages case_component_usages[]

  @@unique([lab_id, name])
  @@index([lab_id])
}

model case_component_usages {
  id            String   @id @default(uuid(7)) @db.Uuid
  case_id       String   @db.Uuid
  component_id  String   @db.Uuid
  quantity      Int      @default(1)
  charge_client Boolean  @default(true)
  unit_cost     Decimal? @db.Decimal(10, 2)
  unit_price    Decimal? @db.Decimal(10, 2)
  notes         String?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  cases      cases      @relation(fields: [case_id], references: [id], onDelete: Cascade)
  components components @relation(fields: [component_id], references: [id], onDelete: Restrict)

  @@index([case_id])
  @@index([component_id])
}

model block_types {
  id           String    @id @default(uuid(7)) @db.Uuid
  lab_id       String    @db.Uuid
  name         String
  material     String?
  brand        String?
  size         String?
  shade        String?
  default_cost Decimal?  @db.Decimal(10, 2)
  is_active    Boolean   @default(true)
  deleted_at   DateTime?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  labs     labs            @relation(fields: [lab_id], references: [id], onDelete: Cascade)
  millings case_millings[]

  @@unique([lab_id, name])
  @@index([lab_id])
}

model cases {
  id                 String     @id @default(uuid(7)) @db.Uuid
  lab_id             String     @db.Uuid
  code               String
  patient_name       String
  customer_id        String?    @db.Uuid
  service_type_id    String?    @db.Uuid
  dentist_id         String?    @db.Uuid
  created_by_user_id String?    @db.Uuid
  current_status     CaseStatus @default(ENTRY)

  teeth        String?
  elements_qty Int?
  shade        String?
  due_date     DateTime?
  is_urgent    Boolean   @default(false)
  observations String?
  pending_note String?

  caseComponentUsages case_component_usages[]
  statusHistory       case_status_histories[]
  millings            case_millings[]
  case_processes      case_processes[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  labs             labs               @relation(fields: [lab_id], references: [id], onDelete: Cascade)
  customers        customers?         @relation(fields: [customer_id], references: [id])
  dentists         dentists?          @relation(fields: [dentist_id], references: [id])
  service_types    service_types?     @relation(fields: [service_type_id], references: [id], onDelete: Restrict)
  createdByUser    users?             @relation("CaseCreatedBy", fields: [created_by_user_id], references: [id])
  case_attachments case_attachments[]
  notifications    notifications[]

  @@unique([lab_id, code])
  @@index([lab_id])
  @@index([lab_id, created_at])
  @@index([lab_id, current_status, created_at])
  @@index([lab_id, customer_id, created_at])
  @@index([customer_id])
  @@index([dentist_id])
  @@index([current_status])
  @@index([service_type_id])
  @@index([created_by_user_id])
}

model case_processes {
  id                     String            @id @default(uuid(7)) @db.Uuid
  case_id                String            @db.Uuid
  process_id             String            @db.Uuid
  workflow_step_id       String
  status                 CaseProcessStatus @default(LOCKED)
  assigned_lab_member_id String?           @db.Uuid
  started_at             DateTime?
  completed_at           DateTime?
  created_at             DateTime          @default(now())
  updated_at             DateTime          @updatedAt

  cases              cases                       @relation(fields: [case_id], references: [id], onDelete: Cascade)
  processes          processes                   @relation(fields: [process_id], references: [id], onDelete: Restrict)
  assignedLabMember  lab_members?                @relation("CaseProcessAssignee", fields: [assigned_lab_member_id], references: [id], onDelete: SetNull)
  dependencies       case_process_dependencies[] @relation("CaseProcessDependencyTarget")
  dependentProcesses case_process_dependencies[] @relation("CaseProcessDependencySource")

  @@unique([case_id, workflow_step_id])
  @@index([case_id])
  @@index([process_id])
  @@index([assigned_lab_member_id])
  @@index([status])
}

model case_process_dependencies {
  id                         String @id @default(uuid(7)) @db.Uuid
  case_process_id            String @db.Uuid
  depends_on_case_process_id String @db.Uuid

  caseProcess          case_processes @relation("CaseProcessDependencyTarget", fields: [case_process_id], references: [id], onDelete: Cascade)
  dependsOnCaseProcess case_processes @relation("CaseProcessDependencySource", fields: [depends_on_case_process_id], references: [id], onDelete: Cascade)

  @@unique([case_process_id, depends_on_case_process_id])
  @@index([case_process_id])
  @@index([depends_on_case_process_id])
}

model case_status_histories {
  id          String      @id @default(uuid(7)) @db.Uuid
  case_id     String      @db.Uuid
  from_status CaseStatus?
  to_status   CaseStatus
  note        String?
  changed_at  DateTime    @default(now())

  cases cases @relation(fields: [case_id], references: [id], onDelete: Cascade)

  @@index([case_id])
  @@index([to_status])
}

model notifications {
  id                String           @id @default(uuid(7)) @db.Uuid
  recipient_user_id String           @db.Uuid
  case_id           String?          @db.Uuid
  type              NotificationType
  title             String
  message           String
  payload           Json?
  is_read           Boolean          @default(false)
  read_at           DateTime?
  created_at        DateTime         @default(now())

  recipientUser users  @relation("NotificationRecipient", fields: [recipient_user_id], references: [id], onDelete: Cascade)
  cases         cases? @relation(fields: [case_id], references: [id], onDelete: SetNull)

  @@index([recipient_user_id, is_read, created_at])
  @@index([case_id])
}

model push_subscriptions {
  id         String   @id @default(uuid(7)) @db.Uuid
  user_id    String   @db.Uuid
  endpoint   String   @unique
  p256dh     String
  auth       String
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  users users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, is_active])
}
